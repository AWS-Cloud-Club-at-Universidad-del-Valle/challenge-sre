// Grafana Alloy: discover Docker container logs and push them to Loki.
// The Docker socket is mounted read-only (see docker-compose.yml).

logging {
  level  = "info"
  format = "logfmt"
}

// Discover running Docker containers.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Keep only the lab app containers (api and service-b) and derive labels
// from container metadata.
discovery.relabel "lab_apps" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(obs-lab-api|obs-lab-service-b)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(obs-lab-api|obs-lab-service-b)"
    target_label  = "service"
  }
}

// Tail logs from the discovered containers.
loki.source.docker "lab_apps" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.lab_apps.output
  labels     = { job = "docker" }
  forward_to = [loki.write.default.receiver]
}

// Push to Loki.
loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
