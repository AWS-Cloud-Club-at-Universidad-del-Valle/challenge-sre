# Copy to .env and adjust. NEVER commit the real .env (it is gitignored).
# On EC2 this .env is generated automatically by the CDK user-data with OTEL_ENABLED=true.

# Grafana admin password (placeholder — change it for your lab)
GF_SECURITY_ADMIN_PASSWORD=changeme

# Load test defaults
LOAD_TEST_RATE=3
LOAD_TEST_DURATION=60

# OpenTelemetry export target (the OTel Collector added in Part 2).
# Part 1 (metrics + logs) runs standalone with OTEL_ENABLED=false (OTel is a no-op).
# For Part 2 (distributed tracing) set OTEL_ENABLED=true so api and service-b
# export spans to the collector and traces appear in Jaeger.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
