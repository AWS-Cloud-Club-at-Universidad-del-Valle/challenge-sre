# Copy to .env and adjust. NEVER commit the real .env (it is gitignored).

# Grafana admin password (placeholder — change it for your lab)
GF_SECURITY_ADMIN_PASSWORD=changeme

# Load test defaults
LOAD_TEST_RATE=3
LOAD_TEST_DURATION=60

# OpenTelemetry export target (the OTel Collector added in Part 2).
# Leave OTEL_ENABLED=false to run Part 1 standalone (OTel becomes a no-op).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
